// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  passwordHash String @default("")
  role      String   @default("petugas")
  createdAt DateTime @default(now())

  stockMovements StockMovement[]
}

model ItemCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Item {
  id        Int      @id @default(autoincrement())
  sku       String   @unique
  name      String
  unit      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockBalances  StockBalance[]
  stockMovements StockMovement[]
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  rows      Int      @default(4)
  cols      Int      @default(3)
  createdAt DateTime @default(now())

  grids Grid[]
}

model Grid {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  warehouseId Int
  row         Int?
  col         Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  stockBalancesHere         StockBalance[]
  stockMovementsSource      StockMovement[] @relation("MovementSource")
  stockMovementsDestination StockMovement[] @relation("MovementDestination")

  @@index([warehouseId])
}

model StockBalance {
  itemId    Int
  gridId    Int
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id])
  grid Grid @relation(fields: [gridId], references: [id])

  @@unique([itemId, gridId])
  @@index([itemId])
  @@index([gridId])
}

model StockMovement {
  id                   Int       @id @default(autoincrement())
  itemId               Int
  type                 String
  quantity             Int
  sourceGridId         Int?
  destinationGridId    Int?
  note                 String?
  createdById          Int
  createdAt            DateTime  @default(now())

  item                Item  @relation(fields: [itemId], references: [id])
  sourceGrid          Grid? @relation("MovementSource", fields: [sourceGridId], references: [id])
  destinationGrid     Grid? @relation("MovementDestination", fields: [destinationGridId], references: [id])
  createdBy           User  @relation(fields: [createdById], references: [id])

  @@index([itemId])
  @@index([createdAt])
}

